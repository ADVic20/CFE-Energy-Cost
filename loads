"""Energy loads support for CFE Energy Cost."""

from dataclasses import dataclass, asdict
from typing import Dict


@dataclass
class EnergyLoad:
    """Represent an electrical load."""

    name: str
    power_w: float
    hours_day: float
    enabled: bool = True

    @property
    def daily_kwh(self) -> float:
        """Daily consumption in kWh."""
        if not self.enabled:
            return 0.0

        return (self.power_w * self.hours_day) / 1000

    @property
    def monthly_kwh(self) -> float:
        """Monthly consumption in kWh."""
        return self.daily_kwh * 30

    @property
    def yearly_kwh(self) -> float:
        """Yearly consumption in kWh."""
        return self.monthly_kwh * 12

    def as_dict(self) -> Dict:
        """Return load data."""
        return asdict(self)


class LoadManager:
    """Manage virtual energy loads."""

    def __init__(self):
        self._loads: Dict[str, EnergyLoad] = {}

    def add_load(self, load: EnergyLoad):
        """Add a new load."""
        self._loads[load.name] = load

    def remove_load(self, name: str):
        """Remove a load."""
        if name in self._loads:
            del self._loads[name]

    def get_load(self, name: str):
        """Get load."""
        return self._loads.get(name)

    def all_loads(self):
        """Return all loads."""
        return self._loads.values()

    def total_monthly_kwh(self) -> float:
        """Total estimated monthly consumption."""
        return sum(
            load.monthly_kwh
            for load in self._loads.values()
            if load.enabled
        )
